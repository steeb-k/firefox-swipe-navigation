// IMPORTANT: the first line of an autoconfig .cfg file is always skipped.
// firefox-swipe-navigation-marker
// Loader for the 1:1 swipe navigation animation.
//
// The installer substitutes @PAYLOAD_URL@ and writes the result to
// <firefox-install-dir>/mozilla.cfg. This file stays deliberately small: it only
// loads the real payload, so you can edit swipe-anim.js and restart Firefox
// without needing root again.
//
// The substitution is a complete file: URL rather than a bare path because the
// two platforms spell one differently: "file:///usr/share/..." on Linux against
// "file:///C:/Users/..." on Windows, where the drive letter takes the place of
// the leading slash. Each installer builds the URL its own way and this file
// stays neutral.

try {
  (function () {
    const PAYLOAD_URL = "@PAYLOAD_URL@";

    const svc =
      (typeof Services !== "undefined" && Services) || globalThis.Services;
    if (!svc) {
      return;
    }
    const iface = (typeof Ci !== "undefined" && Ci) || Components.interfaces;

    // Firefox 155 dropped file: from the schemes loadSubScript will accept, and
    // a payload outside the browser is exactly what it now refuses: it throws
    // "Trying to load untrusted URI." for any file: URL, wherever it lives --
    // inside the install directory included. resource: is still trusted, so map
    // the checkout's directory onto a resource: substitution and load through
    // that. The payload stays where it is and stays editable without root; only
    // the URL Firefox is handed changes.
    //
    // Falls back to the bare file: URL, which is what every version up to 154
    // wants and what still works there, so a failure here is not fatal.
    let loadURL = PAYLOAD_URL;
    try {
      const payloadURI = svc.io.newURI(PAYLOAD_URL);
      // "." resolved against the payload is its containing directory -- built
      // from the URI rather than by trimming the string, so the drive-letter and
      // percent-encoding differences between platforms stay someone else's
      // problem.
      svc.io
        .getProtocolHandler("resource")
        .QueryInterface(iface.nsIResProtocolHandler)
        .setSubstitution(
          "firefox-swipe-navigation",
          svc.io.newURI(".", null, payloadURI)
        );
      loadURL =
        "resource://firefox-swipe-navigation/" +
        payloadURI.QueryInterface(iface.nsIURL).fileName;
    } catch (e) {
      Cu.reportError("[swipe-anim] resource: substitution failed: " + e);
    }

    function loadInto(win) {
      try {
        // Cache-bust so a restart always picks up the edited payload.
        svc.scriptloader.loadSubScript(loadURL + "?v=" + Date.now(), win);
        if (win.SwipeAnim) {
          win.SwipeAnim.install(win);
        }
      } catch (e) {
        Cu.reportError("[swipe-anim] load failed: " + e);
      }
    }

    const observer = {
      observe(subject, topic) {
        if (topic !== "browser-delayed-startup-finished") {
          return;
        }
        loadInto(subject);
      },
    };

    svc.obs.addObserver(observer, "browser-delayed-startup-finished");

    // Catch any window that already finished starting up.
    const e = svc.wm.getEnumerator("navigator:browser");
    while (e.hasMoreElements()) {
      const win = e.getNext();
      if (win.gBrowserInit && win.gBrowserInit.delayedStartupFinished) {
        loadInto(win);
      }
    }
  })();
} catch (e) {
  Cu.reportError("[swipe-anim] autoconfig error: " + e);
}
