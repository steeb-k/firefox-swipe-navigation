// IMPORTANT: the first line of an autoconfig .cfg file is always skipped.
// firefox-swipe-navigation-marker
// Loader for the 1:1 swipe navigation animation.
//
// The installer substitutes @PAYLOAD_URL@ and writes the result to
// <firefox-install-dir>/mozilla.cfg. This file stays deliberately small: it only
// loads the real payload, so you can edit swipe-anim.js and restart Firefox
// without needing root again.
//
// The substitution is a complete file: URL rather than a bare path because the
// two platforms spell one differently: "file:///usr/share/..." on Linux against
// "file:///C:/Users/..." on Windows, where the drive letter takes the place of
// the leading slash. Each installer builds the URL its own way and this file
// stays neutral.

try {
  (function () {
    const PAYLOAD_URL = "@PAYLOAD_URL@";

    const svc =
      (typeof Services !== "undefined" && Services) || globalThis.Services;
    if (!svc) {
      return;
    }

    function loadInto(win) {
      try {
        // Cache-bust so a restart always picks up the edited payload.
        svc.scriptloader.loadSubScript(PAYLOAD_URL + "?v=" + Date.now(), win);
        if (win.SwipeAnim) {
          win.SwipeAnim.install(win);
        }
      } catch (e) {
        Cu.reportError("[swipe-anim] load failed: " + e);
      }
    }

    const observer = {
      observe(subject, topic) {
        if (topic !== "browser-delayed-startup-finished") {
          return;
        }
        loadInto(subject);
      },
    };

    svc.obs.addObserver(observer, "browser-delayed-startup-finished");

    // Catch any window that already finished starting up.
    const e = svc.wm.getEnumerator("navigator:browser");
    while (e.hasMoreElements()) {
      const win = e.getNext();
      if (win.gBrowserInit && win.gBrowserInit.delayedStartupFinished) {
        loadInto(win);
      }
    }
  })();
} catch (e) {
  Cu.reportError("[swipe-anim] autoconfig error: " + e);
}
